# Which model backend the agent uses: offline | anthropic | azure
LLM_PROVIDER=offline

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Azure AI Foundry / Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: real YouTube search for exercise how-to videos
YOUTUBE_API_KEY=

# Optional: write JSONL traces of every agent run here
FITBASKET_TRACE_DIR=traces
